# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI ──────────────────────────────────────────────────────────────────────
# Default provider: Google Gemini (official @google/genai SDK).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<PASTE_YOUR_NEW_API_KEY_HERE>

# Optional overrides:
# AI_PROVIDER=gemini            # force "gemini" or "openai" explicitly
# AI_MODEL=gemini-flash-latest  # per-provider default applies when unset

# Alternative: any OpenAI-compatible provider (OpenAI, Azure, Together, Groq,
# OpenRouter, Ollama…). Used when GEMINI_API_KEY is unset or AI_PROVIDER=openai.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Set to "true" to return a realistic sample report without calling any AI —
# useful for local development and demos.
MOCK_AI=false

# ── Stripe (optional until you enable billing) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
